# Production S3 Storage Configuration
# ======================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# These variables enable production S3 integration tests.
# They are loaded automatically by pytest when running tests/test_production_s3.py

# --- Required for Production S3 Tests ---

# S3 bucket containing CATSHTM catalogs
CATSHTM_S3_BUCKET=ztf-phase2-catshtm

# S3 endpoint URL (leave empty for AWS, or use custom endpoint)
CATSHTM_S3_ENDPOINT=https://s3.west.nikhef.nl

# AWS credentials (for custom endpoints or private buckets)
CATSHTM_S3_ACCESS_KEY=your-access-key-id
CATSHTM_S3_SECRET_KEY=your-secret-access-key
CATSHTM_S3_REGION=us-east-1

# --- Optional Overrides ---

# To override the default MongoDB connection (used by some tests)
# MONGO_URI=mongodb://user:pass@host:port/database

# To override the CATSHTM directory (can be S3 URI)
# CATSHTM_DIR=s3://bucket/path/to/catalogs

# --- ROS3 VFD Debugging (Optional) ---

# Enable verbose HDF5 ROS3 VFD logging
# HDF5_ROS3_VFD_DEBUG=1

# Force path-style S3 URLs
# H5ROSS3_PATH_STYLE=1

# Authentication method for ROS3 VFD
# H5ROSS3_AUTH_METHOD=ENV_VAR

# Disable SSL verification (for development/testing only)
# H5ROSS3_NO_VERIFY_SSL=1
